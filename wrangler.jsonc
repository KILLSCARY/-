{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "p2p-game",
  "main": "worker/index.mjs",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "triggers": {
    "crons": ["0 9 * * *", "30 9 * * *"]
  }
}
